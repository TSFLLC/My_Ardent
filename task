    TRY_CAST(Extension AS INT) AS Extension,
    CAST(FileName AS NVARCHAR(MAX)) AS FileName,
    TRY_CAST(FirstCallResolution AS BIT) AS FirstCallResolution,
    -- HH:MM => same data type (TIME), seconds zeroed so no false precision
    TRY_CAST(
        LEFT(CONVERT(VARCHAR(8), TRY_CAST(HalfHour AS TIME(0)), 108), 5) + ':00'
        AS TIME(0)
    ) AS HalfHour,
    TRY_CAST(HandleTime AS TIME(0)) AS HandleTime,
    TRY_CAST(Holds AS TINYINT) AS Holds,
    TRY_CAST(HoldTime AS TIME(0)) AS HoldTime,
    -- HH:MM => seconds zeroed
    TRY_CAST(
        LEFT(CONVERT(VARCHAR(8), TRY_CAST([Hour] AS TIME(0)), 108), 5) + ':00'
        AS TIME(0)
    ) AS [Hour],
    -- HH => minutes and seconds zeroed (unchanged logic, just TIME(0))
    TRY_CAST(
        RIGHT('00' + HourOfDay, 2) + ':00:00'
        AS TIME(0)
    ) AS HourOfDay,
    TRY_CAST(IvrTime AS TIME(0)) AS IvrTime,
    CAST(MediaType AS NVARCHAR(100)) AS MediaType,
    CAST([Month] AS NVARCHAR(10)) AS [Month],
    TRY_CAST(Parks AS TINYINT) AS Parks,
    TRY_CAST(ParkTime AS TIME(0)) AS ParkTime,
    -- HH:MM => seconds zeroed
    TRY_CAST(
        LEFT(CONVERT(VARCHAR(8), TRY_CAST(QuarterHour AS TIME(0)), 108), 5) + ':00'
        AS TIME(0)
    ) AS QuarterHour,
    TRY_CAST(QueueCallbackProcessing AS BIT) AS QueueCallbackProcessing,
    TRY_CAST(QueueCallbackRegistered AS BIT) AS QueueCallbackRegistered,
    TRY_CAST(QueueCallbackWaitTime AS TIME(0)) AS QueueCallbackWaitTime,
    TRY_CAST(QueueOverflow AS BIT) AS QueueOverflow,
    TRY_CAST(QueueWaitTime AS TIME(0)) AS QueueWaitTime,
