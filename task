      + TRY_CAST(PARSENAME(REPLACE(IvrTime, ':', '.'), 1) AS INT)
        AS IvrTime,

    CAST(MediaType AS NVARCHAR(100)) AS MediaType,
    CAST([Month] AS NVARCHAR(10)) AS [Month],
    TRY_CAST(Parks AS TINYINT) AS Parks,

    -- Changed: TIME(0) -> INT (total seconds)
    TRY_CAST(PARSENAME(REPLACE(ParkTime, ':', '.'), 3) AS INT) * 3600
      + TRY_CAST(PARSENAME(REPLACE(ParkTime, ':', '.'), 2) AS INT) * 60
