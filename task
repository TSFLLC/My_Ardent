    ) AS QuarterHour,

    TRY_CAST(QueueCallbackProcessing AS BIT) AS QueueCallbackProcessing,
    TRY_CAST(QueueCallbackRegistered AS BIT) AS QueueCallbackRegistered,

    -- Not in the client's 13-column list -- left as TIME(0)
    TRY_CAST(QueueCallbackWaitTime AS TIME(0)) AS QueueCallbackWaitTime,

    TRY_CAST(QueueOverflow AS BIT) AS QueueOverflow,

    -- Changed: TIME(0) -> INT (total seconds)
    TRY_CAST(PARSENAME(REPLACE(QueueWaitTime, ':', '.'), 3) AS INT) * 3600
