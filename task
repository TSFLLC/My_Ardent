    TRY_CAST(ServiceLevel AS BIT) AS ServiceLevel,
    CAST(Skill AS NVARCHAR(100)) AS Skill,
    CAST([SoaMin/threshold(sec)] AS NVARCHAR(100))
        AS [SoaMin/threshold(sec)],
    CAST(SourceId AS NVARCHAR(MAX)) AS SourceId,

    -- Changed: TIME(0) -> INT (total seconds) -- see note at top re: possible ms precision
    TRY_CAST(PARSENAME(REPLACE(SpeedOfAnswer, ':', '.'), 3) AS INT) * 3600
