-- =====================================================================
-- This is the accurate, up-to-date version of the ACDReport view,
-- combining every change agreed so far:
--
--   1. Extension: unchanged, kept as INT (client decision -- zero-padding
--      is handled at the reporting layer only, not in SQL).
--   2. [Time]: fixed from the fake-date DATETIMEOFFSET cast to a plain
--      TRY_CAST([Time] AS TIME(0)) -- resolves the "too many characters"
--      issue.
--   3. 13 duration columns converted from TIME(0) to INT (total seconds)
--      for consistency, per client request: AfterCallWorkTime,
--      ConferenceTime, HandleTime, HoldTime, IvrTime, ParkTime,
--      QueueWaitTime, RingTime, SpeedOfAnswer, TalkTime,
--      TalkTimeLessHoldAndPark, TimeToAbandon, TotalQueueTime.
--      Conversion uses PARSENAME to parse HH:MM:SS directly into seconds,
--      which never routes through the TIME type, so it has no 24-hour
--      ceiling (24:01:00 -> 86460, same as any other value).
--
--   NOTE -- SpeedOfAnswer: converted to whole seconds like the rest. If
--   this column needs millisecond precision, flag it and this can be
--   changed to total milliseconds instead.
--
--   NOT changed (not part of the client's 13-column list): ConsultTime,
--   QueueCallbackWaitTime, HalfHour, [Hour], HourOfDay, QuarterHour --
--   still TIME(0), with their original zeroing logic preserved.
-- =====================================================================

ALTER VIEW a
AS

SELECT
    TRY_CAST(Abandoned AS BIT) AS Abandoned,

    -- Changed: TIME(0) -> INT (total seconds)
    TRY_CAST(PARSENAME(REPLACE(AfterCallWorkTime, ':', '.'), 3) AS INT) * 3600
      + TRY_CAST(PARSENAME(REPLACE(AfterCallWorkTime, ':', '.'), 2) AS INT) * 60
      + TRY_CAST(PARSENAME(REPLACE(AfterCallWorkTime, ':', '.'), 1) AS INT)
        AS AfterCallWorkTime,

    CAST(Agent AS NVARCHAR(100)) AS Agent,
    CAST(AgentEmail AS NVARCHAR(100)) AS AgentEmail,
