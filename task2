    TRY_CAST(TotalQueueTime AS TIME(0)) AS TotalQueueTime,
    TRY_CAST(Transfers AS TINYINT) AS Transfers,
    CAST(VisualIvr AS NVARCHAR(100)) AS VisualIvr,
    CAST(VoiceIvr AS NVARCHAR(100)) AS VoiceIvr,
    TRY_CAST(Voicemails AS TINYINT) AS Voicemails,
    TRY_CAST(VoicemailsDeclined AS TINYINT) AS VoicemailsDeclined,
    TRY_CAST(VoicemailsDeleted AS TINYINT) AS VoicemailsDeleted,
    TRY_CAST(VoicemailsHandled AS TINYINT) AS VoicemailsHandled,
    TRY_CAST(VoicemailsReturnedCall AS TINYINT) AS VoicemailsReturnedCall,
    TRY_CAST(VoicemailsTransferred AS TINYINT) AS VoicemailsTransferred,
    TRY_CAST([Year] AS SMALLINT) AS [Year]
FROM B_five9.ACDReport;
