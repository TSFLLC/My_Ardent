    CAST(SourceId AS NVARCHAR(MAX)) AS SourceId,
    TRY_CAST(SpeedOfAnswer AS TIME(0)) AS SpeedOfAnswer,
    TRY_CAST(TalkTime AS TIME(0)) AS TalkTime,
    TRY_CAST(TalkTimeLessHoldAndPark AS TIME(0))
