    TRY_CAST([Time] AS TIME(0)) AS [Time],
    CAST(TimeInterval AS NVARCHAR(MAX)) AS TimeInterval,
    TRY_CAST(TimeToAbandon AS TIME(0)) AS TimeToAbandon,
    TRY_CAST(
        SUBSTRING(
            [Timestamp],
